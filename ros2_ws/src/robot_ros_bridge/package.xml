  <version>0.1.0</version>
  <description>ROS 2 nodes for the Webots TurtleBot assessment project</description>

  <maintainer email="2861833407@qq.com">student</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
